[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "__DIST__"
version = "0.1.0"
description = "SAGE device plugin for the __MANUFACTURER__ __MODEL__"
requires-python = ">=3.11"
dependencies = ["sage-device-sdk__SDK_RANGE__"]

[project.entry-points."sage.devices"]
__ADAPTER__ = "__PACKAGE__:DEVICE"

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
__PACKAGE__ = ["py.typed"]

# Read by plugin/tools/pack.py into the .sagedev manifest: vendor drivers the bench must have installed,
# and package files that must be in the wheel (e.g. "bin/<bridge>.exe").
[tool.sage.package]
vendorDrivers = []
requiredFiles = []
